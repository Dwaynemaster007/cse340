<%- include('partials/header') %>

<main class="container">
  <h1><%= title %></h1>
  <ul>
    <% categories.forEach(category => { %>
      <li>
        <a href="/category/<%= category.category_id %>">
          <strong><%= category.name %></strong>
        </a>: <%= category.description %>
      </li>
    <% }) %>
  </ul>
</main>

<%- include('partials/footer') %>