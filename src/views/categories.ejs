<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (categories && categories.length > 0) { %>
        <ul class="categories-list">
            <% categories.forEach((category) => { %>
                <li><%= category.category_name %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories found.</p>
    <% } %>
</main>

<%- include('partials/footer') %>