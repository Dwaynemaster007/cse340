<%- include('partials/header') %>

<main class="container">
  <h1><%= title %></h1>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <a href="/project/<%= project.project_id %>"><%= project.title %></a> - 
        Hosted by: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
      </li>
    <% }) %>
  </ul>
</main>
<p><a href="/new-project">Add a New Service Project</a></p>
<%- include('partials/footer') %>